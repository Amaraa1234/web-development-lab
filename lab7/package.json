{
  "name": "campusevents-lab7",
  "version": "1.0.0",
  "description": "Лаб 7: CampusEvents портал - Sass/SCSS refactoring",
  "private": true,
  "scripts": {
    "dev": "sass --watch --style=expanded --source-map src/scss/main.scss:css/style.css",
    "build:expanded": "sass --style=expanded --no-source-map src/scss/main.scss:css/style.css",
    "build": "sass --style=compressed --no-source-map src/scss/main.scss:css/style.css"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  }
}
